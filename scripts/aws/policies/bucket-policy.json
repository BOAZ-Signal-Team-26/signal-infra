{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDeleteImmutablePrefixes",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::{{BUCKET}}/raw/*",
        "arn:aws:s3:::{{BUCKET}}/runs/*",
        "arn:aws:s3:::{{BUCKET}}/assets/*"
      ]
    },
    {
      "Sid": "DenyPutWithoutIfNoneMatch",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::{{BUCKET}}/raw/*",
        "arn:aws:s3:::{{BUCKET}}/runs/*",
        "arn:aws:s3:::{{BUCKET}}/assets/*"
      ],
      "Condition": {
        "Null": { "s3:if-none-match": "true" },
        "Bool": { "s3:ObjectCreationOperation": "true" }
      }
    },
    {
      "Sid": "DenyEvalReadExceptEvalRole",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::{{BUCKET}}/eval/*",
      "Condition": {
        "ArnNotEquals": { "aws:PrincipalArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/{{EVAL_ROLE}}" }
      }
    }
  ]
}
